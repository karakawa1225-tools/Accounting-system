# === 必須（本番・開発共通） ===
# Turso / libSQL（本番は https://xxx.turso.io 形式）
TURSO_DATABASE_URL=
# 本番の Turso クラウドでは必須。ローカル file: のみのときは空でも可
TURSO_AUTH_TOKEN=

# セッション署名（32文字以上）例: openssl rand -base64 32
AUTH_SECRET=

# === 初回のみ（管理者作成） ===
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# === 任意 ===
# NEXT_PUBLIC_APP_URL=https://your-domain.example.com
# NODE_ENV=production
